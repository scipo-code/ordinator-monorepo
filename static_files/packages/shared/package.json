{
  "name": "@scipo-code/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "fail": " --name index.ts --structure flat --exportStar --include '**/*.ts' --includeExtension",
    "generate-exports": "barrelsby --directory src/types --delete --exclude index.ts",
    "test": "bash -c 'source .env.test && vitest'",
    "test:run": "bash -c 'source .env.test && vitest run'",
    "test:watch": "bash -c 'source .env.test && vitest --watch'"
  },
  "peerDependencies": {
    "ag-grid-community": ">=33.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "barrelsby": "^2.8.1",
    "tailwindcss": "^4.1.8",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.6"
  }
}