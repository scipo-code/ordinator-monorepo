{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@scipo-code/shared": [
        "packages/shared/src"
      ],
      "@scipo-code/shared/*": [
        "packages/shared/src/*"
      ]
    }
  },
  "references": [
    {
      "path": "./packages/shared"
    },
    {
      "path": "./packages/scheduler"
    },
    {
      "path": "./packages/supervisor"
    }
  ]
}