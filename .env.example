# Ordinator server
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=3000
DATABASE_URL=sqlite:./ordinator.db?mode=rwc
AUTH_PROVIDER=Local # Azure Google...
JWT_SECRET=verysecretjwtstring

ORDINATOR_CORES=2-8
ORDINATOR_PATH=/home/$USER/ordinator

# Set logging location here. WARN: use an absolute path.
ORDINATOR_LOG_DIR=/tmp/

# Debugging
RUST_BACKTRACE=0

# Logging & Tracing
PROFILING_FILE=./benches/tracing.folded
RUST_LOG=info
PROFILING_LEVEL=error
TRACING_LEVEL=info


#=================================================================================#
# THESE SETTINGS ARE NOT ENVIRONMENT VARIABLES, DO NOT CHANGE THEM. They are mock
# values for future database integration.

#DATA
WORK_ORDERS_PATH=./temp_scheduling_environment_database/work_orders.json
EXCEL_DUMP_DIRECTORY=./xlsx_dumps/
